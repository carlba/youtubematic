# Path on the host where downloaded videos will be stored
DOWNLOAD_PATH=/mnt/downloads

# Comma or newline-separated list of YouTube channel URLs to download from
# Example: CHANNELS=https://www.youtube.com/@SomeChannel,https://www.youtube.com/@AnotherChannel
CHANNELS=

# Maximum number of latest episodes to download per channel (leave empty for no limit)
MAX_EPISODES=10

# Only download entries uploaded within the last N days (leave empty for no limit)
MAX_AGE_DAYS=

# Path to the yt-dlp binary (defaults to 'yt-dlp' if not set)
# YT_DLP_PATH=/usr/local/bin/yt-dlp

# CRON pattern for repeated downloads. Leave empty to run once and exit.
# Example: CRON_PATTERN=0 * * * *
# CRON_PATTERN=@hourly

# Plex refresh options
# PLEX_URL=http://plex:32400
PLEX_TOKEN=
PLEX_SECTION_ID=

# Plex refresh Pushover options
PUSHOVER_TOKEN=
PUSHOVER_USER=
